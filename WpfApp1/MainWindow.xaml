<Window x:Class="AutopesulaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autopesula tellimused"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pealkiri -->

        <TextBlock Grid.Row="0"
                   Text="Autopesula tellimused"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Tellimuste tabel -->

        <DataGrid x:Name="OrdersDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="OrdersDataGrid_SelectionChanged">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                <DataGridTextColumn Header="Sõiduki liik"
                                    Binding="{Binding VehicleType}"
                                    Width="*"/>

                <DataGridTextColumn Header="Pesuprogramm"
                                    Binding="{Binding WashProgram}"
                                    Width="*"/>

                <DataGridTextColumn Header="Hind"
                                    Binding="{Binding Price}"
                                    Width="100"/>

                <DataGridTextColumn Header="Kestus (min)"
                                    Binding="{Binding Duration}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>


        <!-- Sisestamise ala -->

        <StackPanel Grid.Row="2"
                    Margin="0,20,0,0">

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,15">

                <StackPanel Margin="0,0,20,0">

                    <TextBlock Text="Sõiduki liik"/>

                    <ComboBox x:Name="VehicleTypeComboBox"
                              Width="180"
                              Margin="0,5,0,0"/>

                </StackPanel>


                <StackPanel>

                    <TextBlock Text="Pesuprogramm"/>

                    <ComboBox x:Name="WashProgramComboBox"
                              Width="180"
                              Margin="0,5,0,0"/>

                </StackPanel>

            </StackPanel>


            <StackPanel Orientation="Horizontal">

                <Button Content="Lisa"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="AddButton_Click"/>

                <Button Content="Muuda"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="EditButton_Click"/>

                <Button Content="Kustuta"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="DeleteButton_Click"/>

                <Button Content="Tühjenda"
                        Width="100"
                        Click="ClearButton_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</Window>